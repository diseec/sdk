#!/bin/sh

export REGISTRY_URL="registry.diseec.com"
export PROJECT_NAME="placeholderforprojectname"
export SERVICE_NAME="placeholderforservicename"
export REPO_NAME="$PROJECT_NAME-$SERVICE_NAME"

command=$1; shift; . "./bin/helpers.sh";
case $command in

    status)
        informer summary-branch-status
        informer forbid-dev-on-main
        informer sync-registry-image
    ;;

    pull)
        message 34 "current branch" "$(git branch --show-current)"
        message "Pulling latest changes .."
        git pull origin
        message "Merging latest 'main' changes .."
        git merge origin/main
        # message "Pulling the image .."
        # docker pull $REGISTRY_URL/$REPO_NAME
    ;;

    build)
        set -e
        message "Building service images .."
        docker compose build --parallel
    ;;

    run)
        if [ "$IS_IN_CONTAINER" = "true" ]; then
        # if [ -f /.dockerenv ] || [ -f /run/.containerenv ]; then
            message "Container environment detected"
            "$@"
        else
            sh $0 service app "$@"
        fi
    ;;

    install)
        set -e
        sh $0 run yarn install
    ;;

    dev)
        set -e
        sh $0 status
        ask_to_run_command "Pull latest repo changes?" sh $0 pull
        ask_to_run_command "Build a fresh image?" sh $0 build
        docker compose up
        docker compose down
        echo "\n"
        message 45 "k1" "DO NOT FORGET TO make PR. 🚀"
        echo "\n"
    ;;

    pro)
        set -e
        message "Starting the production server .."
        docker compose -f docker-compose.yaml up
    ;;

    shell)
        sh $0 run /bin/sh
    ;;

    test)
        if [ -z "$1" ]; then TYPE="all"; else TYPE=$1; shift; fi
        case $TYPE in
            smoke)
                # 
            ;;
            unit)
                # 
            ;;
            e2e)
                message "Running E2E tests .."
                sh $0 service tester npx playwright test "$@"
            ;;
            all)
                message "Running test suite .."
                # sh $0 test smoke
                # sh $0 test unit
                sh $0 test e2e
            ;;
            *)
                echo "Usage: $0"
                echo "  test [smoke|unit|e2e|all]"
                exit 1
            ;;
        esac
    ;;
    
    service)
        SERVICE=$1; shift;
        execute_command_in_container "$SERVICE" "$@"
    ;;

    release)
        TAG="v$(date +%Y%m%d%H%M%S)"
        git checkout main
        git pull origin main
        git tag -a $TAG -m "Release $TAG"
        git push origin $TAG
    ;;

    kit)
        docker run --rm -it \
            -w /app \
            -v "$(pwd)":/app \
            --pull always \
            $REGISTRY_URL/kit kit "$@"
    ;;

    help|--help|-h)
        printf "\n"
        display_help \
            "status   "  "Show project status" \
            "service  "  "Run a command in a service container, usage: service <service-name> <command>" \
            "build    "  "Build the image push to registry" \
            "run      "  "Run a command in fresh instance, usage: run <command>" \
            "pull     "  "Pull the repo and image from registry" \
            "install  "  "Install the dependencies" \
            "dev      "  "Start the development server" \
            "pro      "  "Start the production server" \
            "shell    "  "Start a shell" \
            "test     "  "Run the tests, usage: test [smoke|unit|e2e|all]" \
            "release  "  "Merge to release branch to trigger CD pipeline"
    ;;

    *)
        echo "Unknown command: $command"
        sh $0 --help
        exit 1
    ;;
esac