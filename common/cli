#!/bin/sh
command=$1; shift; . "./bin/helpers.sh";
case $command in

    status)
        informer summary-branch-status
        informer forbid-dev-on-main
        informer sync-registry-image
    ;;

    pull)
        git pull origin
        message "Merging latest 'main' changes to '$(git branch --show-current)' .."
        git merge origin/main
        git pull origin main
        # message "Pulling the image .."
        # docker pull $REGISTRY_URL/$REPO_NAME
    ;;

    build)
        set -e
        message "Building service images .."
        docker compose build --parallel
    ;;

    run)
        if [ "$IS_IN_CONTAINER" = "true" ]; then
        # if [ -f /.dockerenv ] || [ -f /run/.containerenv ]; then
            message "Container environment detected"
            "$@"
        else
            if [ -n "$CI" ]; 
                then OPTIONS="-e CI=true";
                else OPTIONS="-it"; sh $0 status;
            fi

            if docker compose ps -q app | grep -q .; then
                message "Container is running. Executing command inside it .."
                docker compose exec $OPTIONS app "$@"
            else
                message "Running in a fresh instance .."
                docker compose run --rm $OPTIONS app "$@"
            fi
        fi
    ;;

    install)
        set -e
        sh $0 run yarn install
    ;;

    dev)
        set -e
        sh $0 status
        ask_to_run_command "Pull latest repo changes?" sh $0 pull
        ask_to_run_command "Build a fresh image?" sh $0 build
        docker compose up
        docker compose down
        echo "\n"
        message 45 "k1" "DO NOT FORGET TO make PR. 🚀"
        echo "\n"
    ;;

    pro)
        set -e
        message "Starting the production server .."
        docker compose -f docker-compose.yaml up
    ;;

    shell)
        sh $0 run /bin/sh
    ;;

    test)
        set -e;
        if [ -n "$CI" ]; then FLAGS="--fully-parallel --forbid-only --fail-on-flaky-tests"; fi
        # FLAGS=""
        # for arg in "$@"; do
        #     if [ "$arg" = "--ci" ]; then
        #     FLAGS="--fully-parallel --forbid-only --fail-on-flaky-tests"
        #     set -- "${@/--ci/}"
        #     break
        #     fi
        # done
        if [ -z "$1" ]; then TYPE="all"; else TYPE=$1; shift; fi
        case $TYPE in
            smoke)
                # 
            ;;
            unit)
                # 
            ;;
            e2e)
                message "Running E2E tests .."
                docker compose run --rm tester npx playwright test $FLAGS "$@"
            ;;
            all)
                message "Running test suite .."
                # sh $0 test smoke
                # sh $0 test unit
                sh $0 test e2e
            ;;
            *)
                echo "Usage: $0"
                echo "  test [smoke|unit|e2e|all]"
                exit 1
            ;;
        esac
    ;;

    release)
        TAG="v$(date +%Y%m%d%H%M%S)"
        git checkout main
        git pull origin main
        git tag -a $TAG -m "Release $TAG"
        git push origin $TAG
    ;;

    kit)
        docker run --rm -it \
            -w /app \
            -v "$(pwd)":/app \
            --pull always \
            $REGISTRY_URL/kit kit "$@"
    ;;

    help|--help|-h)
        printf "\n"
        display_help \
            "status   "  "Show project status" \
            "build    "  "Build the image push to registry" \
            "run      "  "Run a command in fresh instance" \
            "pull     "  "Pull the repo and image from registry" \
            "install  "  "Install the dependencies" \
            "dev      "  "Start the development server" \
            "pro      "  "Start the production server" \
            "shell    "  "Start the shell" \
            "test     "  "Run the tests" \
            "release  "  "Merge to release branch to trigger CI/CD pipeline"
    ;;

    *)
        echo "Unknown command: $command"
        sh $0 --help
        exit 1
    ;;
esac