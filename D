#!/bin/bash

dir="$PWD"; while :; do
    if [ -f "$dir/cli" ]; then
        export ROOT_DIR="$dir"
        export KIT_DIR="$ROOT_DIR/node_modules/@diseec/kit";
        if [ ! -f "$ROOT_DIR/D" ] && [ ! -d "$KIT_DIR" ]; then 
            docker run --rm -v $dir:/vise image.registry.diseec.com/kit D vise initialize
        fi
        break
    fi
    if [ "$dir" = "/" ]; then
        printf '%s\n' "Error: 'cli' not found, try cd to project root" >&2
        return 1
        break
    fi
    dir=$(dirname -- "$dir")
done

cd $ROOT_DIR; . $KIT_DIR/index.sh; . $CLI "$@";
