#!/bin/bash

ARGS=""; for arg in "$@"; do case "$arg" in
    --force-patch=*) IS_FORCE_PATCH="true";;
*) ARGS="$ARGS \"$arg\"";; esac; done; eval set -- $(eval echo $ARGS);

dir="$PWD"; while :; do
    if [ -f "$dir/cli" ]; then
        ROOT_DIR="$dir";
        KIT_DIR="$ROOT_DIR/node_modules/@diseec/kit";

    if { [ ! -f "$ROOT_DIR/D" ] && { [ ! -d "$KIT_DIR" ] || [ -z "$(ls -A "$KIT_DIR" 2>/dev/null)" ]; } && [ "$IS_IN_CONTAINER" != "true" ]; } || [ "$IS_FORCE_PATCH" = "true" ]; then
            docker pull image.registry.diseec.com/kit
            docker run --rm -v $dir:/vise -w /vise image.registry.diseec.com/kit \
                bash -c "mkdir -p /vise/node_modules/@diseec/kit && \
                    cp -r /kit/* /vise/node_modules/@diseec/kit"
            docker run --rm -v $dir:/vise -w /vise image.registry.diseec.com/kit \
                D kit do patch
            # docker run --rm -v $dir:$TARGET_MOUNTED_DIR -w $TARGET_MOUNTED_DIR $KIT_IMAGE \
            #     bash -c "mkdir -p $TARGET_MOUNTED_DIR/$KIT_RELATIVE_PATH && \
            #         cp -r /$KIT_NAME/* $TARGET_MOUNTED_DIR/$KIT_RELATIVE_PATH"

            if [ ! -d "$KIT_DIR" ]; then
                printf '%s\n' "Error: kit at '$KIT_DIR' not found, try running 'D kit do initialize' in project root" >&2
            fi
        fi
        break
    fi

    if [ "$dir" = "/" ]; then
        printf '%s\n' "Error: 'cli' not found, try cd to project root" >&2
        break
    fi

    dir=$(dirname -- "$dir")
done

$ROOT_DIR/cli "$@";
