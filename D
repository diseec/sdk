#!/bin/bash

set -e

CURRENT_WORKING_DIR="$PWD"

source "$(cd "$(npm root -g)" && pwd)/@diseec/sdk/index.sh"

ARGS=""; for arg in "$@"; do case "$arg" in
    --patch) D_IS_FORCE_PATCH="true" ;;
*) ARGS="$ARGS \"$arg\"";; esac; done; eval set -- $(eval echo $ARGS);

PWD_WORK_DIR="$(src_cor_env_uti_cli_auto_discovery "$CURRENT_WORKING_DIR")";

if [ -n "$PWD_WORK_DIR" ]; then
    # "$PWD_WORK_DIR/cli" install function src_fac_set_ensure_patched \
    #     "${D_IS_FORCE_PATCH:-false}" "$PWD_WORK_DIR"
    env WORK_DIR="PWD_WORK_DIR" "$PWD_WORK_DIR/cli" "$@"
elif [ -n "$WORK_DIR" ]; then
    "$WORK_DIR/cli" "$@"
else
    "$SDK_DIR/cli" "$@"
fi

