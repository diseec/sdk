#!/bin/bash

main() {
case $1 in
    local-kit-index-path)
        echo '$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/node_modules/@diseec/kit/index.sh'
        shift
        return 0
    ;;
esac

dir="$PWD"; while :; do
    if [ -f "$dir/cli" ]; then
        ROOT_DIR="$dir";
        KIT_DIR="$ROOT_DIR/node_modules/@diseec/kit";

        if [ ! -f "$ROOT_DIR/D" ] && [ ! -d "$KIT_DIR" ]; then 
            # note: without this below command, get weird error 'docker: command not found'!
            docker run --rm -v $dir:/vise -w /vise --pull always image.registry.diseec.com/kit \
                bash -c "mkdir -p /vise/node_modules/@diseec/kit && \
                    cp -r /kit/* /vise/node_modules/@diseec/kit"
            docker run --rm -v $dir:/vise -w /vise --pull always image.registry.diseec.com/kit \
                bash -c "D kit do patch"
            # docker run --rm -v $dir:/$PROJECT_MOUNT_DIR_NAME -w /$PROJECT_MOUNT_DIR_NAME $KIT_IMAGE \
            #     bash -c "mkdir -p /$PROJECT_MOUNT_DIR_NAME/$KIT_RELATIVE_PATH && \
            #         cp -r /$KIT_NAME/* /$PROJECT_MOUNT_DIR_NAME/$KIT_RELATIVE_PATH"

            if [ ! -d "$KIT_DIR" ]; then
                printf '%s\n' "Error: kit at '$KIT_DIR' not found, try running 'D kit do initialize' in project root" >&2
                exit 1
            fi
        fi
        break
    fi

    if [ "$dir" = "/" ]; then
        printf '%s\n' "Error: 'cli' not found, try cd to project root" >&2
        exit 1
        break
    fi

    dir=$(dirname -- "$dir")
done

$ROOT_DIR/cli "$@";

}

main "$@"