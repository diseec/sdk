#!/bin/bash

: ${D_D_CLI_EXECUTED:=true}

source "${D_SDK_DIR:-$(cd "$(npm root -g)" && pwd)"/@diseec/sdk"}/index.sh"

if [ -n "$D_CTX_DIR" ]; then
    # Ensure sdk is installed and patched if needed
    ("$D_CLI_STUB" install function sdk_fac_ins_ensure_patched)
