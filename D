#!/bin/bash

ARGS=(); for arg in "$@"; do
    if [[ "$arg" == "--patch" && -z "$SEEN_PATCH" ]]; then SEEN_PATCH=1
        D_IS_FORCE_PATCH="true"
else ARGS+=("$arg"); fi; done; set -- "${ARGS[@]}"

dir="$PWD"; while :; do
    if [ -f "$dir/cli" ]; then
        ROOT_DIR="$dir";
        KIT_DIR="$ROOT_DIR/node_modules/@diseec/kit";

        if { [ ! -f "$ROOT_DIR/D" ] && { [ ! -d "$KIT_DIR" ] || [ -z "$(ls -A "$KIT_DIR" 2>/dev/null)" ]; } && [ "$IS_IN_CONTAINER" != "true" ]; } || [ "$D_IS_FORCE_PATCH" = "true" ]; then
            docker pull image.registry.diseec.com/kit --disable-content-trust 2>/dev/null
            docker run --rm -v $dir:/vise -w /vise image.registry.diseec.com/kit \
                bash -c "mkdir -p /vise/node_modules/@diseec/kit && \
                    cp -r /kit/* /vise/node_modules/@diseec/kit"
            docker run --rm -v $dir:/vise -w /vise image.registry.diseec.com/kit \
                D kit act patch
            # docker run --rm -v $dir:$TARGET_MOUNTED_DIR -w $TARGET_MOUNTED_DIR $KIT_IMAGE \
            #     bash -c "mkdir -p $TARGET_MOUNTED_DIR/$KIT_RELATIVE_PATH && \
            #         cp -r /$KIT_NAME/* $TARGET_MOUNTED_DIR/$KIT_RELATIVE_PATH"
        fi

        if [ ! -d "$KIT_DIR" ]; then
            printf '%s\n' "Error: kit at '$KIT_DIR' not found" >&2
            printf '%s\n' "Fix: try installing with '--patch' option" >&2
        fi
        break
    fi

    if [ "$dir" = "/" ]; then
        printf '%s\n' "Error: 'cli' not found, try cd to project root" >&2
        break
    fi

    dir=$(dirname -- "$dir")
done

$ROOT_DIR/cli "$@";
