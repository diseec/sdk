#!/bin/bash

IS_KIT_CLI="true"

source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/index.sh"
source "$ROOT_DIR/facades/index.sh"

c=$1; shift; case $c in
    act)       force_safe $c "$@" || source "$ROOT_DIR/facades/act/cli.sh" "$@" ;;
    tes|test)  force_safe $c "$@" || source "$KIT_SRC_DIR/lib/tester/cli.sh" "$@" ;;
    pul|pull)  cli_main git _ pull origin main "$@" ;;
    run)       cli_main docker compose execute $KIT_NAME "$@" ;;
    sta|start) cli_main docker compose _ up --detach --force-recreate "$@" ;;
    sto|stop)  cli_main docker compose _ down --timeout 0 "$@" ;;
    hel|help|--help|-h) display_help \
            "" "" "$(ansi 37 'Usage')" "" \
            "$(ansi 37 '    kit <command> [subcommand] [options] [arguments]')" "" \
            "" "" "$(ansi 37 'Kit Container Lifecycle')" "" \
            "    sta|start               " "Start kit container (for fast subsequent ops)" \
            "    sto|stop                " "Stop kit container" \
            "    shell                   " "Open shell in kit container (project is mounted)" \
            "" "" "$(ansi 37 'Project Management & Modification')" "" \
            "    do <cmd>                " "Run kit-powered commands to manage/modify projects" \
            "    ini|initialize          " "Install kit into a managed project" \
            "                            " "Other project modification commands (see docs)" \
            "" "" "$(ansi 37 'Source Control')" "" \
            "    pul|pull                " "Pull latest changes from main branch in kit context" \
            "" "" "$(ansi 37 'Information')" "" \
            "    hel|help                " "Show this help message" \
            "" "" "$(ansi 34 'Note:')" " This cli manages the kit container and project operations. For project cli, use the installed cli in your project root." \
            "$(ansi 34 'Docs:')" " See https://github.com/diseec/kit for full command reference."
        ;;

    *) cli_core $c "$@" ;;
esac
