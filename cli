#!/bin/bash

IS_KIT_CLI="true"
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/index.sh"

c=$1; shift; case $c in
    do)
    if [ "$IS_IN_KIT_CONTAINER" != "true" ]; then message 41 "!" "The 'do' command works only on bench! (the kit container)"; exit 1; fi
    c=$1; shift; case $c in
        pat|patch)
            set -e
            VERSION_SPECIFIER=$(_node -p "require('$TARGET_MOUNTED_DIR/package.json').dependencies?.['@$ORG_NAME/$KIT_NAME'] || require('$TARGET_MOUNTED_DIR/package.json').devDependencies['@$ORG_NAME/$KIT_NAME']")
            if [ -z "$VERSION_SPECIFIER" ]; then
                message 41 "!" "@$ORG_NAME/$KIT_NAME not found in '$TARGET_MOUNTED_DIR/package.json'."
                exit 1
            fi
            echo "Running npm install @$ORG_NAME/$KIT_NAME@$VERSION_SPECIFIER .."
            TMPDIR=$(mktemp -d)
            (cd $TMPDIR && _npm install "@$ORG_NAME/$KIT_NAME@$VERSION_SPECIFIER")
            rm -rf "$TARGET_MOUNTED_DIR/$KIT_RELATIVE_PATH" 2>/dev/null 
            mkdir -p "$TARGET_MOUNTED_DIR/$KIT_RELATIVE_PATH" 2>/dev/null
            cp -r "$TMPDIR/$KIT_RELATIVE_PATH"/* "$TARGET_MOUNTED_DIR/$KIT_RELATIVE_PATH"
            if [ ! -f "$TARGET_MOUNTED_DIR/cli" ]; then cp "/$KIT_NAME/templates/cli" "$TARGET_MOUNTED_DIR/cli"; fi
            # if [ ! -f "$TARGET_MOUNTED_DIR/.gitignore" ]; then cp "/$KIT_NAME/templates/.gitignore" "$TARGET_MOUNTED_DIR/.gitignore"; fi
        ;;
        # templates) bash bin/templates.sh ;;
        *)
            display_help \
                "" "" \
                "$(color 30 'Package Visibility Commands')" "" \
                "    ins|install             " "Install package dependencies in Node.js project"
        ;;
    esac;;

    tes|test) force_safe $c "$@" || source "$KIT_SRC_DIR/lib/tester/index.sh" "$@" ;;
    run) cli_main docker compose exec $KIT_NAME "$@" ;;
    pul|pull) cli_main git pull origin main "$@" ;;
    sta|start) cli_main docker compose up "$@" ;;
    sto|stop) cli_main docker compose down "$@" ;;
    hel|help|--help|-h)
        display_help \
            "" "" \
            "$(color 30 'Usage')" "" \
            "$(color 30 '    kit <command> [subcommand] [options] [arguments]\n')" "" \
            "$(color 30 'Kit Container Lifecycle')" "" \
            "    sta|start               " "Start kit container (for fast subsequent ops)" \
            "    sto|stop                " "Stop kit container" \
            "    shell                   " "Open shell in kit container (project is mounted)" \
            "" "" \
            "$(color 30 'Project Management & Modification')" "" \
            "        do <cmd>          " "Run kit-powered commands to manage/modify projects" \
            "        ini|initialize      " "Install kit into a managed project" \
            "        ...                 " "Other project modification commands (see docs)" \
            "" "" \
            "$(color 30 'Source Control')" "" \
            "    pul|pull                " "Pull latest changes from main branch in kit context" \
            "" "" \
            "$(color 30 'Information')" "" \
            "    hel|help                " "Show this help message" \
            "" "" \
            "$(color 34 'Note:')" "This cli_main manages the kit container and project operations. For project cli_main, use the installed cli in your project root." \
            "$(color 34 'Docs:')" "See https://github.com/diseec/kit for full command reference."
        ;;

    *) cli_core "$c" "$@" ;;
esac
