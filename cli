#!/bin/bash

export CLI_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"; . $CLI_ROOT/index.sh; cd $ROOT_DIR; command=$1; shift;

case $command in

    install)
        set -e
        if [ -f $PROJECT_MOUNT_DIR/package.json ]; then
            message "Installing in Node.js project .."
            VERSION_SPECIFIER=$(node -p "require('$PROJECT_MOUNT_DIR/package.json').dependencies?.['@diseec/$KIT_NAME'] || require('$PROJECT_MOUNT_DIR/package.json').devDependencies['@diseec/$KIT_NAME']")
            if [ -z "$VERSION_SPECIFIER" ]; then
                echo "@diseec/$KIT_NAME not found in dependencies or devDependencies."
                exit 1
            fi
            message "Running npm install @diseec/$KIT_NAME@$VERSION_SPECIFIER .."
            TMPDIR=$(mktemp -d)
            (cd $TMPDIR && npm install "@diseec/$KIT_NAME@$VERSION_SPECIFIER")
            rm -rf $PROJECT_MOUNT_DIR/node_modules/@diseec/$KIT_NAME 2>/dev/null
            mkdir -p $PROJECT_MOUNT_DIR/node_modules/@diseec/$KIT_NAME 2>/dev/null
            cp -r $TMPDIR/node_modules/@diseec/$KIT_NAME $PROJECT_MOUNT_DIR/node_modules/@diseec
            if [ ! -f $PROJECT_MOUNT_DIR/cli ]; then cp /app/templates/cli $PROJECT_MOUNT_DIR/cli; fi
            # if [ ! -f $PROJECT_MOUNT_DIR/.gitignore ]; then cp /app/templates/.gitignore /project/.gitignore; fi
        fi
    ;;

    shell)
        $CLI run /bin/bash
    ;;

    pull)
        git pull origin main
    ;;

    build) cmd_build "$@" ;;
    shell) cmd_shell "$@" ;;
    run) cmd_run "$@" ;;
    exec)
        if ! docker compose ps -q "$KIT_NAME" | grep -q .; then
            docker compose up --no-recreate -d "$KIT_NAME" >/dev/null 2>&1
        fi
        cmd_exec "$@"
    ;;

    release)
        . $CLI_SRC/cmds/update.sh
        CURRENT_VERSION=$(get_version_specifier)
        
        # Extract parts of the semantic version (x.y.z)
        VERSION_MAJOR=$(echo $CURRENT_VERSION | sed -E 's/^([0-9]+)\.([0-9]+)\.([0-9]+).*$/\1/')
        VERSION_MINOR=$(echo $CURRENT_VERSION | sed -E 's/^([0-9]+)\.([0-9]+)\.([0-9]+).*$/\2/')
        VERSION_PATCH=$(echo $CURRENT_VERSION | sed -E 's/^([0-9]+)\.([0-9]+)\.([0-9]+).*$/\3/')
        
        # Increment the patch part (z)
        NEW_PATCH=$((VERSION_PATCH + 1))
        NEXT_VERSION="${VERSION_MAJOR}.${VERSION_MINOR}.${NEW_PATCH}"
        
        message 34 "RELEASE" "Incrementing version $CURRENT_VERSION → $NEXT_VERSION"
        
        # Update package.json version if needed
        if [ -f "./package.json" ]; then
            # Check if we're in the package directory
            if grep -q "\"name\": \"@diseec/$KIT_NAME\"" "./package.json"; then
                message 34 "PACKAGE" "Updating package.json version..."
                sed -i.bak "s/\"version\": \"$CURRENT_VERSION\"/\"version\": \"$NEXT_VERSION\"/" "./package.json"
                rm -f "./package.json.bak"
                
                # Create a tag for the new version
                message 34 "GIT" "Creating tag v$NEXT_VERSION..."
                (cd "." && git add package.json && git commit -am "Release v$NEXT_VERSION" && git tag -a "v$NEXT_VERSION" -m "Release v$NEXT_VERSION")
                
                # Ask to push
                message 32 "DONE" "Version updated to $NEXT_VERSION"
                ask_to_run_command "Push changes and tags to remote?" git push && git push --tags
            else
                message 33 "WARNING" "This is not the $KIT_NAME package directory, can't update version directly"
            fi
        else
            message 33 "WARNING" "No package.json found"
        fi
    ;;

    # MODIFIERS

    # devops)
    #     subcommand=$1 && shift
    #     case $subcommand in
    #         override)
    #             bash bin/apply_templates.sh
    #         ;;
    #         *)
    #             echo "Unknown subcommand: $subcommand"
    #             echo "Usage: $0 $KIT_NAME [subcommand]"
    #             echo "commands:"
    #             echo "   override     Apply the templates"
    #             exit 1
    #         ;;
    #     esac
    # ;;

    help|--help|-h)
        printf "\n"
        display_help \
            "run     " "Run a command in fresh instance" \
            "build   " "Build the images push to registry" \
            "install " "Install the dependencies" \
            "shell   " "Start the shell" \
            "$KIT_NAME  " "Run $KIT_NAME commands"
        ;;

    *) $CLI_SRC/cli.sh "$command" "$@" ;;
esac