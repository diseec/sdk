#!/bin/bash

export IS_KIT_CLI="true";
export KIT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"; . $KIT_DIR/index.sh; cd $ROOT_DIR; command=$1; shift;

case $command in

    install)
        # set -e
        # $CLI run yarn install;
        cmd_install "$@";
    ;;

    vise) command_2=$1; shift; case $command_2 in
        install)
            set -e
            if [ -f $PROJECT_MOUNT_DIR/package.json ]; then
                message "Installing in Node.js project .."
                VERSION_SPECIFIER=$(node -p "require('$PROJECT_MOUNT_DIR/package.json').dependencies?.['@$ORG_NAME/$KIT_NAME'] || require('$PROJECT_MOUNT_DIR/package.json').devDependencies['@$ORG_NAME/$KIT_NAME']")
                if [ -z "$VERSION_SPECIFIER" ]; then
                    echo "@$ORG_NAME/$KIT_NAME not found in dependencies or devDependencies."
                    exit 1
                fi
                message "Running npm install @$ORG_NAME/$KIT_NAME@$VERSION_SPECIFIER .."
                TMPDIR=$(mktemp -d)
                (cd $TMPDIR && npm install "@$ORG_NAME/$KIT_NAME@$VERSION_SPECIFIER")
                rm -rf $PROJECT_MOUNT_DIR/node_modules/@$ORG_NAME/$KIT_NAME 2>/dev/null
                mkdir -p $PROJECT_MOUNT_DIR/node_modules/@$ORG_NAME/$KIT_NAME 2>/dev/null
                cp -r $TMPDIR/node_modules/@$ORG_NAME/$KIT_NAME $PROJECT_MOUNT_DIR/node_modules/@$ORG_NAME
                if [ ! -f $PROJECT_MOUNT_DIR/cli ]; then cp /app/templates/cli $PROJECT_MOUNT_DIR/cli; fi
                # if [ ! -f $PROJECT_MOUNT_DIR/.gitignore ]; then cp /app/templates/.gitignore /project/.gitignore; fi
            fi
        ;;
    esac;;

    shell)
        $CLI run /bin/bash
    ;;

    pull)
        git pull origin main
    ;;

    build) cmd_build "$@" ;;
    shell) cmd_shell "$@" ;;
    run) cmd_run "$@" ;;
    exec)
        if ! docker compose ps -q "$KIT_NAME" | grep -q .; then
            docker compose up --no-recreate -d "$KIT_NAME" >/dev/null 2>&1
        fi
        cmd_exec "$@"
    ;;

    # MODIFIERS

    # devops)
    #     subcommand=$1 && shift
    #     case $subcommand in
    #         override)
    #             bash bin/apply_templates.sh
    #         ;;
    #         *)
    #             echo "Unknown subcommand: $subcommand"
    #             echo "Usage: $0 $KIT_NAME [subcommand]"
    #             echo "commands:"
    #             echo "   override     Apply the templates"
    #             exit 1
    #         ;;
    #     esac
    # ;;

    help|--help|-h)
        printf "\n"
        display_help \
            "run     " "Run a command in fresh instance" \
            "build   " "Build the images push to registry" \
            "install " "Install the dependencies" \
            "shell   " "Start the shell" \
            "$KIT_NAME  " "Run $KIT_NAME commands"
        ;;

    *) $KIT_SRC_DIR/cli.sh "$command" "$@" ;;
esac