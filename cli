#!/bin/bash

IS_KIT_CLI="true"

source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/index.sh"
source "$ROOT_DIR/facades/index.sh"

c=$1; shift; case $c in
    act)       force_safe $c "$@" || source "$ROOT_DIR/facades/act/cli.sh" "$@" ;;
    tes|test)  force_safe $c "$@" || source "$KIT_SRC_DIR/lib/tester/cli.sh" "$@" ;;
    pul|pull)  cli_main git _ pull origin main "$@" ;;
    run) cli_main docker compose execute $KIT_NAME "$@" ;;
    sta|start)
        message -l "Starting $KIT_NAME container..."
        cli_main docker compose _ up --no-color --detach --force-recreate "$@"
        # output=$(cli_main docker compose _ up --no-color --detach --force-recreate "$@" 2>&1)
        # status=$?
        # if [ $status -ne 0 ]; then
        #     message -e "Failed to start $KIT_NAME container"
        #     echo "$output"
        # fi
        ;;
    sto|stop)
        message -l "Stopping $KIT_NAME container..."
        cli_main docker compose _ down --timeout 0 "$@"
        # output=$(cli_main docker compose _ down --timeout 0 "$@" 2>&1)
        # status=$?
        # if [ $status -ne 0 ]; then
        #     message -e "Failed to stop $KIT_NAME container"
        #     echo "$output"
        # fi
        ;;
        hel|help|--help|-h) cli_core help \
            "" "" "$(ansi "1;90" "$(capitalize 'Kit Container Lifecycle')")" "" \
            "    sta|start               " "Start kit container (for fast subsequent ops)" \
            "    sto|stop                " "Stop kit container" \
            "    act <command>           " "Run kit-powered commands to manage/modify projects" "" "" \
            "$(ansi "2;90" 'This cli manages the kit container and project operations,')" "" \
            "$(ansi "2;90" 'for project cli, use the installed cli in your project root.')" ""
        ;;

    *) cli_core $c "$@" ;;
esac
