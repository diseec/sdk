#!/bin/bash

IS_SDK_CLI="true"

source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/index.sh"

c=$1; shift; case $c in
    pat|patch) cli_main install sdk "$@" ;;
    tes|test)  source_safely "$SDK_SRC_DIR/lib/tester/cli.sh" "$@" ;;
    pul|pull)  cli_main git _ pull origin main "$@" ;;
    clo|clone)
        local scope_dir="$(src_fac_con_get_scope_work_dir "$1")"
        cli_main git _ clone https://$REPO_HUB_URL/"$1" "$scope_dir"
        logit -l "Cloned repository into $scope_dir"
        ;;
    bui|build)
        _docker compose build \
            --build-arg SDK_NAME="$SDK_NAME" \
            --build-arg WORK_DIR_CONTAINER="$WORK_DIR_CONTAINER" \
            --parallel "$@"
        ;;
    run) cli_main docker compose execute $SDK_NAME "$@" ;;
    sta|start)
        logit -l "Starting $SDK_NAME container..."
        # cli_main docker compose _ up --no-color --detach --force-recreate "$@"
        output=$(cli_main docker compose _ up --no-color --detach --force-recreate "$@" 2>&1)
        status=$?
        if [ $status -ne 0 ]; then
            logit -e "Failed to start $SDK_NAME container"
            echo "$output"
        fi
        ;;
    sto|stop)
        logit -l "Stopping $SDK_NAME container..."
        # cli_main docker compose _ down --timeout 0 "$@"
        output=$(cli_main docker compose _ down --timeout 0 "$@" 2>&1)
        status=$?
        if [ $status -ne 0 ]; then
            logit -e "Failed to stop $SDK_NAME container"
            echo "$output"
        fi
        ;;
        hel|help|--help|-h) cli_core help \
            "" "" "$(ansi "1;90" "$(capitalize 'Kit Container Lifecycle')")" "" \
            "    sta|start               " "Start sdk container (for fast subsequent ops)" \
            "    sto|stop                " "Stop sdk container" \
            "    act <command>           " "Run sdk-powered commands to manage/modify projects" "" "" \
            "" "" "$(ansi "1;90" "$(capitalize 'Repository Modifier Commands')")" "" \
            "    pat|patch             " "Force fresh install to mounted directory" \
            "    clo|clone             " "Clone a repository into the workspace"
            "$(ansi "2;90" 'This cli manages the sdk container and project operations,')" "" \
            "$(ansi "2;90" 'for project cli, use the installed cli in your project root.')" ""
        ;;

    *) cli_core $c "$@" ;;
esac
