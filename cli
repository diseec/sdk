#!/bin/bash

if [ "$(pwd)" != "/kit" ]; then
  cd /kit
fi
source bin/helpers.sh
command=$1 && shift

case $command in
    build)
        set -e
        # docker buildx build \
        #     --platform linux/amd64,linux/arm64 \
        #     -t $REGISTRY_URL/kit \
        #     --push .
        docker buildx build \
            --platform linux/amd64,linux/arm64 \
            -f images/tester-e2e-node \
            -t $REGISTRY_URL/tester-e2e-node \
            --push .
    ;;

    run)
        if [ -f /.dockerenv ]; then
            "$@"
        else
            if [ -z "$CI" ]; then
                IT_OPTION="-it"
            else
                IT_OPTION=""
            fi
            docker run --rm $IT_OPTION \
                --pull always \
                -v "$(pwd)":/app \
                -w /app \
                $REGISTRY_URL/kit "$@"
        fi
    ;;

    install)
        set -e
        bash $0 run npm install
    ;;

    shell)
        bash $0 run /bin/bash
    ;;

    # MODIFIERS

    devops)
        subcommand=$1 && shift
        case $subcommand in
            override)
                bash bin/apply_templates.sh
            ;;
            *)
                echo "Unknown subcommand: $subcommand"
                echo "Usage: $0 devops [subcommand]"
                echo "commands:"
                echo "   override     Apply the templates"
                exit 1
            ;;
        esac
    ;;

    help|--help|-h)
        color 0 "\n"
        message "Dev team's toolkit. template, fix, build ..!"
        display_help \
            "run     " "Run a command in fresh instance" \
            "build   " "Build the images push to registry" \
            "install " "Install the dependencies" \
            "shell   " "Start the shell" \
            "devops  " "Run devops commands"
        ;;

    *)
        echo "Unknown command: $command"
        bash $0 --help
        exit 1
    ;;
esac