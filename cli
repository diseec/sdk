#!/bin/bash

. ./common/bin/helpers.sh; command=$1; shift;

case $command in
    build)
        set -e
        docker buildx build \
            --platform linux/arm64 \
            -t image.registry.diseec.com/devops:latest \
            --push .
            # --platform linux/amd64,linux/arm64 \
    ;;

    # run)
    #     if [ -f /.dockerenv ]; then
    #         "$@"
    #     else
    #         if [ -z "$CI" ]; then
    #             IT_OPTION="-it"
    #         else
    #             IT_OPTION=""
    #         fi
    #             # --pull always \
    #         docker run --rm $IT_OPTION \
    #             -v "$(pwd)":/app \
    #             -w /app \
    #             image.registry.diseec.com/devops:latest "$@"
    #     fi
    # ;;

    install)
        set -e
        if [ -f /project/package.json ]; then
            message "Installing in Node.js project .."
            VERSION_SPECIFIER=$(node -p "require('/project/package.json').dependencies['@diseec/devops'] || (require('/project/package.json').devDependencies && require('/project/package.json').devDependencies['@diseec/devops'])")
            if [ -z "$VERSION_SPECIFIER" ]; then
                echo "@diseec/devops not found in dependencies or devDependencies."
                exit 1
            fi
            message "Running npm install @diseec/devops@$VERSION_SPECIFIER .."
            TMPDIR=$(mktemp -d)
            (cd $TMPDIR && npm install "@diseec/devops@$VERSION_SPECIFIER")
            rm -rf /project/node_modules/@diseec/devops 2>/dev/null
            mkdir -p /project/node_modules/@diseec/devops 2>/dev/null
            cp -r $TMPDIR/node_modules/@diseec/devops /project/node_modules/@diseec
            if [ ! -f /project/cli ]; then cp /app/cli.example /project/cli; fi
        fi
    ;;

    shell)
        bash $0 run /bin/bash
    ;;

    pull)
        git pull origin main
    ;;

    # MODIFIERS

    devops)
        subcommand=$1 && shift
        case $subcommand in
            override)
                bash bin/apply_templates.sh
            ;;
            *)
                echo "Unknown subcommand: $subcommand"
                echo "Usage: $0 devops [subcommand]"
                echo "commands:"
                echo "   override     Apply the templates"
                exit 1
            ;;
        esac
    ;;

    help|--help|-h)
        color 0 "\n"
        message "Dev team's toolkit. template, fix, build ..!"
        display_help \
            "run     " "Run a command in fresh instance" \
            "build   " "Build the images push to registry" \
            "install " "Install the dependencies" \
            "shell   " "Start the shell" \
            "devops  " "Run devops commands"
        ;;

    *)
        echo "Unknown command: $command"
        bash $0 --help
        exit 1
    ;;
esac