#!/bin/bash

cd $(dirname "$0") && command=$1 && shift

case $command in
    build)
        set -e
        docker buildx build \
            --platform linux/amd64,linux/arm64 \
            -t registry.diseec.com/toolkit \
            --push .
    ;;

    run)
        if [ -f /.dockerenv ]; then
            "$@"
        else
            if [ -z "$CI" ]; then
                IT_OPTION="-it"
            else
                IT_OPTION=""
            fi
            docker run --rm $IT_OPTION \
                -v "$(pwd)":/app \
                -w /app \
                registry.diseec.com/toolkit "$@"
        fi
    ;;

    install)
        set -e
        bash $0 run npm install
    ;;

    shell)
        bash $0 run /bin/bash
    ;;

    # MODIFIERS

    devops)
        subcommand=$1 && shift
        case $subcommand in
            override)
                bash bin/apply_templates.sh
            ;;
            *)
                echo "Unknown subcommand: $subcommand"
                echo "Usage: $0 devops [subcommand]"
                echo "Subcommands:"
                echo "  "
                exit 1
            ;;
        esac
    ;;

    --help|-h)
        echo "Usage: $0 [command]"
        echo "Commands:"
        echo "  run            Run a command in fresh instance"
        echo "  build          Build the images push to registry"
        echo "  install        Install the dependencies"
        echo "  shell          Start the shell"
        echo "  devops         Run devops commands"
        exit 0
    ;;

    *)
        echo "Unknown command: $command"
        bash $0 --help
        exit 1
    ;;
esac