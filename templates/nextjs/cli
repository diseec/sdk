#!/bin/bash

cd $(dirname "$0"); command=$1; shift;

. ./node_modules/@diseec/kit/src/helpers.sh

case $command in
    install)        
        if [ -n "$SERVICE_NAME" ]; then
            sh cli run yarn install
            # if [ -z "$CI" ]; then
            #     confirm "Install test utils?" sh cli run yarn playwright install
            # else
            #     sh cli run yarn playwright install
            # fi
        fi

        "./node_modules/@diseec/kit/cli.sh" install "$@" 
    ;;

    help|-h)        
        "./node_modules/@diseec/kit/cli.sh" "$command" \
         "" "" \
         "$(ansi 33 "Service Commands:")" "" \
         "    help         " "Display this help message"
    ;;

    *)              
        "./node_modules/@diseec/kit/cli.sh" "$command" "$@" 
    ;;

esac