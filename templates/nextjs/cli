#!/bin/sh
command=$1; shift; . "./bin/helpers.sh";
case $command in

    status)
        informer summary-branch-status
        informer forbid-dev-on-main
        informer sync-registry-image
    ;;

    pull)
        git pull origin
        message "Merging latest 'main' changes to '$(git branch --show-current)' .."
        git merge origin/main
        git pull origin main
        message "Pulling the image .."
        docker pull $REGISTRY_URL/$REPO_NAME
    ;;

    build)
        set -e
        docker build -t $REGISTRY_URL/$REPO_NAME
    ;;

    run)
        if [ "$IS_IN_CONTAINER" = "true" ]; then
            message "Container environment detected"
            "$@"
        else
            if [ -z "$CI" ]; then INTERACTIVE="-it"; fi
            bash $0 status
            if docker compose ps -q app | grep -q .; then
                message "Container is running. Executing command inside it .."
                docker compose exec $INTERACTIVE app "$@"
            else
                message "Running in a fresh instance .."
                docker compose run --rm $INTERACTIVE app "$@"
            fi
        fi
    ;;

    install)
        set -e
        sh $0 run npm install
    ;;

    dev)
        set -e
        bash $0 status
        message 45 "☺︎" "Happy Coding! -K1"
        docker compose up
        message 43 "!" "Don't forget to make PR. -K1"
    ;;

    pro)
        set -e
        message "Starting the production server .."
        docker compose -f docker-compose.yaml up
    ;;

    shell)
        sh $0 run /bin/sh
    ;;

    test)
        set -e
        sh $0 run npm run lint
        # sh $0 run npm run test
    ;;

    release)
        TAG="v$(date +%Y%m%d%H%M%S)"
        git checkout main
        git pull origin main
        git tag -a $TAG -m "Release $TAG"
        git push origin $TAG
    ;;

    kit)
        docker run --rm -it \
            -w /app \
            -v "$(pwd)":/app \
            --pull always \
            $REGISTRY_URL/kit kit "$@"
    ;;

    help|--help|-h)
        printf "\n"
        display_help \
            "status   "  "Show project status" \
            "build    "  "Build the image push to registry" \
            "run      "  "Run a command in fresh instance" \
            "pull     "  "Pull the repo and image from registry" \
            "install  "  "Install the dependencies" \
            "dev      "  "Start the development server" \
            "pro      "  "Start the production server" \
            "shell    "  "Start the shell" \
            "test     "  "Run the tests" \
            "release  "  "Merge to release branch to trigger CI/CD pipeline"
    ;;

    *)
        echo "Unknown command: $command"
        sh $0 --help
        exit 1
    ;;
esac