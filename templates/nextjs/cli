#!/bin/sh

command=$1 && shift
. "./bin/helpers.sh"

REPO_NAME="placeholderforprojectid-placeholderforprojectname"

case $command in
    build)
        set -e
        message "Building image .."
        docker build --cache-from=registry.diseec.com/$REPO_NAME \
            -t registry.diseec.com/$REPO_NAME .
    ;;

    run)
        if [ "$IMAGE_NAME" = "$REPO_NAME" ]; then
            message 46 "(in-container: $IMAGE_NAME)"
            "$@"
        else
            if [ -z "$CI" ]; then
                IT_OPTION="-it"; 
            else 
                message 44 'info' "Running in CI mode (non-interactive) .."
                IT_OPTION=""; 
            fi

            if docker-compose ps -q app | grep -q .; then
                message 44 'info' "Container $REPO_NAME is already running. Executing command inside it .."
                docker-compose exec $IT_OPTION app "$@"
            else
                message 44 'info' "Running in a fresh instance .."
                docker-compose run --rm $IT_OPTION \
                    -e IMAGE_NAME=$REPO_NAME \
                    app "$@"
            fi
        fi
    ;;

    pull)
        git pull origin
        message "Pulling latest 'main' branch changes .."
        git merge origin/main
        git pull origin main
        message "Pulling the image .."
        docker pull registry.diseec.com/$REPO_NAME
    ;;

    install)
        set -e
        sh $0 run npm install
    ;;

    dev)
        set -e
        message 45 "☺︎" "Push to 'dev' branch, and don't forget to make PR tonight. Happy Coding! -K1\n"
        message "Starting the development server .."
        docker-compose up
    ;;

    pro)
        set -e
        message "Building the production image .."
        sh $0 build
        message "Starting the production server .."
        docker-compose -f docker-compose.yaml up
    ;;

    shell)
        sh $0 run /bin/sh
    ;;

    test)
        set -e
        sh $0 run npm run lint
        # sh $0 run npm run test
    ;;

    release)
        TAG="v$(date +%Y%m%d%H%M%S)"
        git checkout main
        git pull origin main
        git tag -a $TAG -m "Release $TAG"
        git push origin $TAG
    ;;

    kit)
        docker run --rm -it \
            -w /app \
            -v "$(pwd)":/app \
            --pull always \
            registry.diseec.com/kit kit "$@"
    ;;

    help|--help|-h)
        printf "\n"
        display_help \
            "build     "  "Build the image push to registry" \
            "run       "  "Run a command in fresh instance" \
            "pull      "  "Pull the repo and image from registry" \
            "install   "  "Install the dependencies" \
            "dev       "  "Start the development server" \
            "pro"      "Start the production server" \
            "shell     "  "Start the shell" \
            "test      "  "Run the tests" \
            "release   "  "Merge to release branch to trigger CI/CD pipeline"
    ;;

    *)
        echo "Unknown command: $command"
        sh $0 --help
        exit 1
    ;;
esac