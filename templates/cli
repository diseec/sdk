#!/bin/bash

# -------------------------------------------------------
# DISEEC DevOps Toolkit
# This script  provides a unified  command-line interface
# for  project-level  DevOps  and  automation  tasks.  It
# leverages  the  @diseec/sdk  Node.js  package for  core
# functionality and can be extended here to add or modify
# commands specific to this project.
# -------------------------------------------------------

source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/node_modules/@diseec/sdk/index.sh"

c=$1; shift; case $c in

    dev)
        confirm "Run pre-development options?" \
            cli_ctx status \
            confirm "Pull and merge latest changes?" cli_ctx --recursive pull

        cli_core dev "$@"

        cli_ctx format
        confirm "Commit, push and PR changes?" cli_ctx --recursive push
    ;;

    # hook:after_install) yarn install ;;

    # hel|help|--help|-h) cli_core --help "" "" "$(ansi "1;90" "$(capitalize "$D_REPO_NAME Commands")")" "" \
    #     "    myc|mycommand" "            Display the help message" ;;

    *) cli_core $c "$@" ;;

esac
