#!/bin/bash

: ${D_SDK_CLI_EXECUTED:=true}

source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/index.sh"

c=$1; shift; case $c in
    pat|patch) cli_ctx install sdk "$@" ;;
    pul|pull)  cli_ctx git _ pull origin main "$@" ;;
    bui|build)
        _docker compose build \
            --build-arg D_SDK_NAME="$D_SDK_NAME" \
            --build-arg D_CTX_DIR_CONTAINER="$D_CTX_DIR_CONTAINER" \
            --parallel "$@"
        ;;
    run) cli_ctx docker compose execute $D_SDK_NAME "$@" ;;
    sta|start)
        logit -l "Starting $D_SDK_NAME container..."
        # cli_ctx docker compose _ up --no-color --detach --force-recreate "$@"
        output=$(cli_ctx docker compose _ up --no-color --detach --force-recreate "$@" 2>&1)
        status=$?
        if [ $status -ne 0 ]; then
            logit -e "Failed to start $D_SDK_NAME container"
            echo "$output"
        fi
        ;;
    sto|stop)
        logit -l "Stopping $D_SDK_NAME container..."
        # cli_ctx docker compose _ down --timeout 0 "$@"
        output=$(cli_ctx docker compose _ down --timeout 0 "$@" 2>&1)
        status=$?
        if [ $status -ne 0 ]; then
            logit -e "Failed to stop $D_SDK_NAME container"
            echo "$output"
        fi
        ;;
        hel|help|--help|-h) cli_core help \
            "" "" "$(ansi "1;94" "$(capitalize 'Kit Container Lifecycle')")" "" \
            "    sta|start               " "Start sdk container (for fast subsequent ops)" \
            "    sto|stop                " "Stop sdk container" \
            "    act <command>           " "Run sdk-powered commands to manage/modify projects" "" "" \
            "" "" "$(ansi "1;94" "$(capitalize 'Repository Modifier Commands')")" "" \
            "    pat|patch             " "Force fresh install to mounted directory" \
            "    clo|clone             " "Clone a repository into the workspace" "" "" \
            "$(ansi "2;90" 'This cli manages the sdk container and project operations,')" "" \
            "$(ansi "2;90" 'for project cli, use the installed cli in your project root.')" ""
        ;;

    *) cli_core $c "$@" ;;
esac
