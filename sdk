#!/bin/bash

: ${D_SDK_CLI_EXECUTED:=true}

source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/index.sh"

c=$1; shift; case $c in

    tes|tester) mark_ctx_only; export D_GLOB_ENV="TESTING"; source_safely "$D_SDK_DIR/facades/tester/cli.sh" "$@" ;;

    pul|pull)   cli_ctx git _ pull origin main "$@" ;;

    run)        cli_ctx docker compose execute $D_SDK_NAME "$@" ;;

    dev) source "$D_SDK_DIR/utils/dev.sh" "$@" ;;

    bui|build)
        cli_ctx docker compose _ build \
            --build-arg D_SDK_NAME="$D_SDK_NAME" \
            --build-arg D_CONT_CTX_DIR="$D_CONT_CTX_DIR" \
            --parallel "$@"
        ;;

    sta|start)
        stdout -l --processing "Starting $D_SDK_NAME container"
        # cli_ctx docker compose _ up --no-color --detach --force-recreate "$@"
        output=$(cli_ctx docker compose _ up --no-color --detach --force-recreate "$@" 2>&1)
        status=$?
        if [ $status -ne 0 ]; then
            stdout -e "Failed to start $D_SDK_NAME container"
            echo "$output"
        fi
        ;;

    sto|stop)
        stdout -l --processing "Stopping $D_SDK_NAME container"
        # cli_ctx docker compose _ down --timeout 0 "$@"
        output=$(cli_ctx docker compose _ down --timeout 0 "$@" 2>&1)
        status=$?
        if [ $status -ne 0 ]; then
            stdout -e "Failed to stop $D_SDK_NAME container"
            echo "$output"
        fi
        ;;
        --help|-h|hel|help) cli_core --help \
            "" "" "$(ansi "1;94" "$(capitalize 'Kit Container Lifecycle')")" "" \
            "    sta|start               " "Start sdk container (for fast subsequent ops)" \
            "    sto|stop                " "Stop sdk container" \
            "    act <command>           " "Run sdk-powered commands to manage/modify projects" "" "" \
            "" "" "$(ansi "1;94" "$(capitalize 'Repository Modifier Commands')")" "" \
            "    clo|clone             " "Clone a repository into the workspace" "" "" \
            "$(ansi "2;90" 'This cli manages the sdk container and project operations,')" "" \
            "$(ansi "2;90" 'for project cli, use the installed cli in your project root.')" ""
        ;;
    
    # Overrides
    doc|docker) c=$1; shift; case $c in
        com|compose) c=$1; shift; case $c in
            _)
                if [ "$D_GLOB_ENV" = "TESTING" ]; then
                    compose_file="$D_SDK_DIR/docker/docker-compose.testing.yaml"
                else
                    compose_file="$D_SDK_DIR/docker/docker-compose.development.yaml"
                fi
                cli_core docker compose $c -f "$compose_file" "$@"
                ;;
            *) cli_core docker compose $c "$@" ;;
        esac ;;
    esac ;;

    *) cli_core $c "$@" ;;
esac
