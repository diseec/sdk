#!/bin/sh

export ROOT_DIR="$(cd "$(dirname "$0")" && pwd)"; cd $ROOT_DIR; command=$1; shift; case $command in install) docker run --pull always --rm -v $(pwd):/project image.registry.diseec.com/devops sh cli install ;; esac; . ./node_modules/@diseec/devops/imports.sh;

# -----------------------------------------------------------------------------
# DISEEC CLI Helper Script
#
# This script provides a unified command-line interface for project-level
# DevOps and automation tasks. It leverages the @diseec/devops Node.js package
# for core functionality and can be extended here to add or modify commands
# specific to this project.
#
# -----------------------------------------------------------------------------

case $command in
    install) cmd_install "$@" ;;
    status) cmd_status "$@" ;;
    pull) cmd_pull "$@" ;;
    dev) cmd_dev "$@" ;;
    pro) cmd_pro "$@" ;;
    build) cmd_build "$@" ;;
    run) cmd_run "$@" ;;
    exec) cmd_exec "$@" ;;
    shell) cmd_shell "$@" ;;
    test) cmd_test "$@" ;;
    release) cmd_release "$@" ;;
    kit) cmd_kit "$@" ;;
    service) cmd_service "$@" ;;
    package) cmd_package "$@" ;;
    help|--help|-h)
        cmd_help \
         "" "" \
         "$(color 33 'Service Commands:')" "" \
         "    help         " "Display the help message";
    ;;
    *) cmd_unknown "$@" ;;
esac

$CLI_SRC/cli.sh "$command" "$@";