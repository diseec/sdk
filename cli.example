#!/bin/sh

export ROOT_DIR="$(cd "$(dirname "$0")" && pwd)"; cd $ROOT_DIR; command=$1; shift; case $command in install) docker run --pull always --rm -u "$(id -u):$(id -g)" -v $(pwd):/project image.registry.diseec.com/devops sh cli install ;; esac; . ./node_modules/@diseec/devops/imports.sh;

# -----------------------------------------------------------------------------
# DISEEC CLI Helper Script
#
# This script provides a unified command-line interface for project-level
# DevOps and automation tasks. It leverages the @diseec/devops Node.js package
# for core functionality and can be extended here to add or modify commands
# specific to this project.
#
# -----------------------------------------------------------------------------

case $command in
    my-command)
        message "Add your command logic here"
    ;;

    help|--help|-h)
        $CLI_SRC/cli.sh "$command" \
         "" "" \
         "$(color 33 'Service Commands:')" "" \
         "    help         " "Display the help message";
    ;;

esac

$CLI_SRC/cli.sh "$command" "$@";